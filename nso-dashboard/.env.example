# Copy this file to nso-dashboard/.env and fill in your credentials.
# NEVER commit .env — it is listed in .gitignore.

# ── Meta Marketing API ──────────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# ── Google Ads ──────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ── Google / GA4 / GBP ──────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=nso-dashboard/credentials/service_account.json

# ── Snowflake ────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_ROLE=

# ── GBP OAuth ────────────────────────────────────────────────────────────────
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
