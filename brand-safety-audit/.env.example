# Copy this file to brand-safety-audit/.env and fill in your credentials.
# NEVER commit .env — it is listed in the repo's root .gitignore (**/.env).

# ── Buffer (GraphQL API) ─────────────────────────────────────────────────────
# Get one at: Buffer → Settings → API → Create a new API key
# Scope needed: at least posts:read
BUFFER_API_TOKEN=

# ── Anthropic (Claude API) ───────────────────────────────────────────────────
# Get one at: platform.claude.com → Settings → API Keys
ANTHROPIC_API_KEY=
